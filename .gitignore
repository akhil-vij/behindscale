node_modules
dist
dist-ssr
.DS_Store
*.local
.env
.env.*
!.env.example

# Claude Code per-user local settings (project-shared settings.json would be tracked)
.claude/settings.local.json

# build/cache directories
.vite
.vitest-cache
.cache
coverage
*.tsbuildinfo

# Playwright artifacts
test-results
playwright-report
blob-report
.playwright

# the deferred pipeline's SQLite state (context/pipeline-architecture-deferred.md);
# kept so a future pipeline run can't commit it
processed.db
processed.db-shm
processed.db-wal
pipeline/processed.db
pipeline/processed.db-shm
pipeline/processed.db-wal

# compiled artifact bundles — written by scripts/compile-artifacts.ts from
# content/artifacts/*.jsx on every build
public/artifacts/*
!public/artifacts/.gitkeep

# figure SVGs mirrored from content/figures/ by scripts/copy-figures.ts.
# Source of truth lives under content/figures/<article>/<slug>.svg;
# the build copies each file here so Vite ships it as a static asset.
public/figures/*
!public/figures/.gitkeep

# transient delivery bundles (pattern rounds, design zips)
*.zip
